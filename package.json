{
  "name": "sunset-survivors",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "assets:check": "node scripts/audit-assets.mjs --check",
    "assets:audit": "node scripts/audit-assets.mjs --list",
    "check": "tsc --noEmit && npm test && npm run assets:check",
    "music:import": "node scripts/import-stage-music.mjs",
    "music:prompts": "node scripts/import-stage-music.mjs --prompts",
    "balance:audit": "node scripts/audit-balance.mjs",
    "sustain:audit": "node scripts/audit-sustain.mjs",
    "balance:telemetry": "node scripts/audit-telemetry.mjs",
    "start": "node server/index.mjs",
    "ranking:backup": "node server/backup.mjs",
    "ranking:check": "node scripts/check-ranking-server.mjs",
    "economy:audit": "node scripts/audit-economy.mjs"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
