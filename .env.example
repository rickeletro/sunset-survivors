# Production Node server (export these variables in the process environment).
PORT=3000
HOST=0.0.0.0
# Use an absolute path on persistent storage in production.
RANKING_DB_PATH=.data/rankings.sqlite

# Static hosting: set this at BUILD time to the deployed Worker API URL.
# Optional override: production defaults to the live rickeletro Worker; dev defaults to the local API.
# This is a public URL, never a secret token.
VITE_RANKING_API_URL=
